<Window x:Class="TodoListApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Todo List Manager" Height="650" Width="950"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Load JSON" Click="BtnLoad_Click" Padding="10,5" Margin="0,0,8,0"/>
                <Button Content="Save JSON" Click="BtnSave_Click" Padding="10,5" Margin="0,0,8,0"/>
                <Button Content="Delete" Click="BtnDelete_Click" Background="#FFDDDD" Padding="10,5"/>
            </StackPanel>

            <DataGrid x:Name="TasksDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionChanged="TasksDataGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*"/>
                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                    <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat=yyyy-MM-dd}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="14">
            <StackPanel>
                <TextBlock Text="Task Details" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                <TextBlock Text="Title:" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtTitle" Margin="0,0,0,10"/>

                <TextBlock Text="Description:" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtDescription" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

                <TextBlock Text="Due Date:" Margin="0,0,0,4"/>
                <DatePicker x:Name="DpDueDate" Margin="0,0,0,10"/>

                <TextBlock Text="Priority:" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbPriority" Margin="0,0,0,10"/>

                <TextBlock Text="Status:" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbStatus" Margin="0,0,0,14"/>

                <Button Content="Add Task" Click="BtnAdd_Click" Height="30" Margin="0,0,0,6"/>
                <Button Content="Update Task" Click="BtnUpdate_Click" Height="30" Margin="0,0,0,6"/>
                <Button Content="Clear Form" Click="BtnClear_Click" Height="26"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>